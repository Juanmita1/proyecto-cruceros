{
  "name": "bagtags-pwa",
  "private": true,
  "version": "1.0.0",
  "description": "Lector de Bagtags — PWA offline: ticket de control de equipaje en cinta con envío del PDF por email",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "icons": "node scripts/generate-icons.mjs"
  },
  "dependencies": {
    "idb": "8.0.4",
    "jspdf": "3.0.4",
    "preact": "10.29.8",
    "workbox-window": "7.4.1",
    "zxing-wasm": "3.1.6"
  },
  "devDependencies": {
    "@preact/preset-vite": "2.10.6",
    "fake-indexeddb": "6.2.7",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "3.2.7"
  }
}
